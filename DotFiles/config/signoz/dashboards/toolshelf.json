              "y": 6
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Problems"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/c657242c-10f9-5a41-adac-06362ba3f712"
              },
              "height": 6,
