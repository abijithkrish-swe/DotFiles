{
  "schemaVersion": "v6",
  "name": "toolshelf",
  "image": "/assets/Icons/eight-ball",
  "tags": null,
  "spec": {
    "display": {
      "name": "toolshelf: agent runs",
      "description": "Every toolshelf run (sandbox or docker) as a trace: what agents run, where time goes, what fails or is blocked. Built by DotFiles/config/signoz/dashboards/build.mjs."
    },
    "duration": "",
    "layouts": [
