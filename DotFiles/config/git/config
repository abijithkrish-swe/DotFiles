[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  tags = tag -l
  branches = branch -a
  remotes = remote -v
  unpushed = log --branches --not --remotes --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  undo = reset --hard HEAD~1
  prune-branches = !git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
  prune-branches-safe = !"git remote prune origin && git branch -vv --format='%(refname:short) %(upstream:track)' \
    | awk '$2 ~ /\\[gone\\]/ {print $1}' \
    | grep -Ev '^(master|main|develop)$' \
    | xargs -p -r git branch -D"

[core]
	excludesfile = ~/.gitignore_global
  attributesfile = ~/.gitattributes
	editor = /usr/bin/vim
	pager = less -X -R -F
	autocrlf = false

[merge]
	tool = vimdiff

[push]
	default = current

[color]
  ui = true
  branch = auto
  diff = auto
  status = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[branch]
	autosetuprebase = always

[help]
  autocorrect = 1

[http]
  postBuffer = 5242880
	proxy = http://127.0.0.1:3128
	#proxy = http://127.0.0.1:3128

[url "https://"] 
  insteadOf = git://
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[filesystem "Oracle Corporation|1.8.0_77|/dev/disk1s1"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_77|/dev/disk1s5"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_77|/dev/disk1s5s1"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_152|/dev/disk3s1s1"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	useHttpPath = true
