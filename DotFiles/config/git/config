[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  tags = tag -l
  branches = branch -a
  remotes = remote -v
  unpushed = log --branches --not --remotes --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  undo = reset --hard HEAD~1
  prune-branches = !"r=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null | cut -d/ -f1); [ -n \"$r\" ] || r=origin; git remote prune \"$r\" >/dev/null 2>&1; git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2==\"[gone]\" {print $1}' | while IFS= read -r b; do [ -n \"$b\" ] && git branch -D \"$b\"; done"
  prune-branches-safe = !"r=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null | cut -d/ -f1); [ -n \"$r\" ] || r=origin; git remote prune \"$r\" >/dev/null 2>&1; git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2==\"[gone]\" {print $1}' | grep -Ev '^(master|main|develop)$' | while IFS= read -r b; do [ -n \"$b\" ] || continue; printf 'Delete branch %s? [y/N] ' \"$b\" > /dev/tty; IFS= read -r ans < /dev/tty; case \"$ans\" in y|Y) git branch -D \"$b\" ;; *) echo \"Skipped $b\" ;; esac; done"

[core]
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes
	editor = /usr/bin/vim
	pager = less -X -R -F
	autocrlf = false

[merge]
	tool = vimdiff

[push]
	default = current

[color]
  ui = true
  branch = auto
  diff = auto
  status = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[branch]
	autosetuprebase = always

[help]
  autocorrect = 1

[http]
  postBuffer = 5242880
	proxy = http://127.0.0.1:3128
	#proxy = http://127.0.0.1:3128

[url "https://"] 
  insteadOf = git://
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[filesystem "Oracle Corporation|1.8.0_77|/dev/disk1s1"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_77|/dev/disk1s5"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_77|/dev/disk1s5s1"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_152|/dev/disk3s1s1"]
	timestampResolution = 1001 milliseconds
	minRacyThreshold = 0 nanoseconds
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	useHttpPath = true

# Identity is machine-local and never stored in this repo.
# Create or change it with: install_copy.sh identity
#   ~/.config/git/identity      default [user] + per-folder includeIf rules
#   ~/.config/git/identity.d/*  one [user] per folder rule
[include]
	path = ~/.config/git/identity

# Machine-specific overrides (never in this repo), included last so they win.
# e.g. this Mac's absolute credential helper path:
#   [credential]
#   	helper =              # empty value clears the inherited helper list
#   	helper = /abs/path/to/git-credential-osxkeychain
[include]
	path = ~/.config/git/local
