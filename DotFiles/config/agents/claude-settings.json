{
  "permissions": {
    "allow": [
      "mcp__toolshelf__list_components",
      "mcp__toolshelf__get_component_versions",
      "mcp__toolshelf__get_defaults",
      "mcp__toolshelf__get_component_env",
      "mcp__toolshelf__resolve_toolsrc",
      "mcp__toolshelf__request_component",
      "mcp__toolshelf__colima_status"
    ],
    "ask": [
      "mcp__toolshelf__run"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(brew install:*)",
      "Bash(brew upgrade:*)",
      "Bash(brew reinstall:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(rustup:*)",
      "Bash(cargo install:*)",
      "Bash(sdk install:*)",
      "Bash(nvm install:*)",
      "Bash(softwareupdate:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/agents/guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
