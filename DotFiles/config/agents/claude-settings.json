{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4317",
    "OTEL_RESOURCE_ATTRIBUTES": "agent.config={agent_config}",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "OTEL_METRICS_INCLUDE_ENTRYPOINT": "true",
    "OTEL_METRICS_INCLUDE_REPOSITORY": "true",
    "OTEL_METRICS_EXPORT_INTERVAL": "15000"
  },
  "permissions": {
    "allow": [
      "mcp__toolshelf__list_components",
      "mcp__toolshelf__get_component_versions",
      "mcp__toolshelf__get_defaults",
      "mcp__toolshelf__get_component_env",
      "mcp__toolshelf__resolve_toolsrc",
      "mcp__toolshelf__request_component",
      "mcp__toolshelf__colima_status",
      "Bash(docker image inspect *)",
      "Bash(docker history *)",
      "Bash(colima status *)",
      "Bash(docker system df *)",
      "Bash(git merge-base *)",
      "Bash(colima list *)",
      "Bash(claude mcp get *)",
      "Bash(docker image ls *)",
      "Bash(docker compose logs *)",
      "Bash(shasum *)",
      "Bash(docker compose ps *)",
      "Bash(defaults read *)",
      "Bash(sips -g *)"
    ],
    "ask": [
      "mcp__toolshelf__run"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(brew install:*)",
      "Bash(brew upgrade:*)",
      "Bash(brew reinstall:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(rustup:*)",
      "Bash(cargo install:*)",
      "Bash(sdk install:*)",
      "Bash(nvm install:*)",
      "Bash(softwareupdate:*)",
      "Edit(~/.config/agents/**)",
      "Edit(~/.config/components/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.config/claude-personal/settings.json)",
      "Edit(~/.config/claude-personal/settings.local.json)",
      "Edit(~/.codex/AGENTS.md)",
      "Edit(~/.codex/config.toml)",
      "Edit(~/.codex/rules/**)",
      "Edit(~/Library/Application Support/Claude/claude_desktop_config.json)",
      "Edit(~/.cursor/mcp.json)",
      "Read(~/.codex/auth.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/agents/guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Sosumi.aiff &",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff &",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
